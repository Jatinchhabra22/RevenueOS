# Application
APP_ENV=development
APP_NAME=revenue-recovery-orchestrator
RANDOM_SEED=42

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Paths (relative to repository root unless absolute)
DATA_DIR=data
ARTIFACTS_DIR=artifacts
ACTIVE_DATASET=demo
# MODELS_DIR=artifacts/models
UPLOAD_MAX_BYTES=25000000

# LLM
AGENT_MODE=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
MAX_AGENT_ITERATIONS=3
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Risk engine (optional override; defaults live in config/risk_engine.json)
# RISK_CONFIG_PATH=config/risk_engine.json
